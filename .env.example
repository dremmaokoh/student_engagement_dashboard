# Copy this file to server/.env and fill in local values.
# Never commit real secrets or connection strings with credentials.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/student_engagement
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
AUTH_REGISTER_ENABLED=true

# Optional. If unset, reset emails are skipped; development/test still return a resetUrl for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Student Engagement Dashboard <noreply@localhost>
